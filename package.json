{
  "name": "client-presentation-template",
  "private": true,
  "version": "0.1.0",
  "description": "White-label presentation template: brand kit boards, design system and Home concepts (Vite MPA, strict TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "prepare:data": "node tools/prepare.mjs",
    "typecheck": "npm run prepare:data && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pretest": "npm run prepare:data",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/production/site.test.mjs",
    "build:ds": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "verify": "npm test && npm run build && npm run check && npm run test:build"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@tabler/icons": "^3.48.0",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lightningcss": "^1.33.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
